---
import Icon from './Icon.astro';
import { unsplash } from '../data/site';

interface Props { variant?: 'sage-wash' | 'sage-panel' | 'warm-dark'; id?: string }
const { variant = 'sage-wash', id = 'hero-naslov' } = Astro.props;
const photo = {
  'sage-wash': '1570172619644-dfd03ed5d881',
  'sage-panel': '1616394584738-fc6e612e71b9',
  'warm-dark': '1761718209708-9ab9ba1c7252',
}[variant];
---
<section class:list={['hero', variant]} aria-labelledby={id}>
  <img
    class="hero-img"
    src={unsplash(photo, 1920)}
    srcset={`${unsplash(photo, 900)} 900w, ${unsplash(photo, 1400)} 1400w, ${unsplash(photo, 2200)} 2200w`}
    sizes="100vw"
    alt="Tretman lica u studiju"
    fetchpriority="high"
  />
  <div class="hero-copy wrap">
    <div class="panel">
      <h1 id={id} class="zn-heading zn-heading-display">Rezultati koje <em class="zn-accent">vidite</em></h1>
      <p class="hero-line">Tretmani lica i tijela naprednim uređajima, uz više od 10 godina iskustva.</p>
      <div class="hero-actions">
        <a class="zn-btn" href="#upit">Pošalji upit <Icon name="arrow-right" /></a>
        <a class="zn-btn zn-btn-outline ghost" href="#tretmani">Pogledaj tretmane</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero { position: relative; display: flex; align-items: flex-end; min-height: max(560px, calc(100svh - 168px)); overflow: hidden; isolation: isolate; background: var(--surface-mist); }
  .hero-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; animation: hero-drift 14s var(--ease-out) both; }
  .hero::after { content: ''; position: absolute; inset: 0; z-index: -1; }
  @keyframes hero-drift { from { transform: scale(1.06); } to { transform: scale(1); } }
  .hero-copy { padding-block: var(--space-120) var(--space-80); }
  .panel { display: grid; gap: var(--space-24); justify-items: start; }
  .zn-heading-display { font-size: clamp(44px, 6.4vw, 88px); line-height: 0.95; max-width: 9.5em; }
  .zn-heading-display .zn-accent { font-size: 1.14em; }
  .hero-line { font-size: 18px; line-height: 30px; max-width: 34ch; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: var(--space-8); }
  @media (prefers-reduced-motion: reduce) { .hero-img { animation: none; } }

  /* A: sage wash — the brand colour carries the legibility instead of white */
  .sage-wash .hero-img { object-position: 70% 35%; }
  .sage-wash::after { background: linear-gradient(90deg, #aed7a4f2 0%, #aed7a4d9 28%, #aed7a466 52%, #aed7a400 72%), linear-gradient(180deg, #aed7a499 0%, #aed7a400 20%); }
  .sage-wash .zn-accent { color: var(--leaf); }
  .sage-wash .ghost { background: #ffffff8c; }
  .sage-wash .ghost:hover { background: var(--ink); }

  /* B: sage panel — a solid sharp-edged sage block holds the copy over a full-bleed warm photo */
  .sage-panel .hero-img { object-position: 60% 40%; }
  .sage-panel::after { background: linear-gradient(180deg, #ffffffb3 0%, #ffffff00 16%); }
  .sage-panel .hero-copy { padding-bottom: 0; }
  .sage-panel .panel { background: var(--sage); padding: var(--space-48) var(--space-48) var(--space-48); margin-left: calc(-1 * var(--space-48)); max-width: 640px; }
  .sage-panel .zn-heading-display { font-size: clamp(40px, 5.2vw, 72px); }
  .sage-panel .ghost { background: transparent; }

  /* C: warm and low-key — dark ink wash, white type, sage accent */
  .warm-dark .hero-img { object-position: 60% 45%; }
  .warm-dark::after { background: linear-gradient(90deg, #1f2a24e6 0%, #1f2a24b3 34%, #1f2a2400 70%), linear-gradient(0deg, #1f2a2499 0%, #1f2a2400 40%); }
  .warm-dark .zn-heading, .warm-dark .hero-line { color: var(--on-ink); }
  .warm-dark .zn-accent { color: var(--sage); }
  .warm-dark .zn-btn:not(.ghost) { background: var(--sage); border-color: var(--sage); color: var(--ink); }
  .warm-dark .zn-btn:not(.ghost):hover { background: var(--on-ink); border-color: var(--on-ink); }
  .warm-dark .ghost { color: var(--on-ink); border-color: var(--on-ink); background: transparent; }
  .warm-dark .ghost:hover { background: var(--on-ink); color: var(--ink); }

  @media (max-width: 760px) {
    .hero { min-height: 640px; }
    .hero-copy { padding-block: var(--space-80) var(--space-48); }
    .sage-wash::after { background: linear-gradient(0deg, #aed7a4 0%, #aed7a4f0 40%, #aed7a400 72%); }
    .warm-dark::after { background: linear-gradient(0deg, #1f2a24f2 0%, #1f2a24cc 42%, #1f2a2400 75%); }
    .sage-panel .hero-copy { padding: 0; }
    .sage-panel .panel { margin: 0; max-width: none; padding: var(--space-32) var(--space-16); }
  }
</style>
