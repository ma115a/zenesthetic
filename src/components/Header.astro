---
import Icon from './Icon.astro';
import { nav, studio } from '../data/site';

interface Props { overlay?: boolean }
const { overlay = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '');
const isCurrent = (href: string) => path === href || path.startsWith(href + '/');
---
<header class:list={['site-header', { overlay }]} data-header>
  <div class="bar wrap">
    <a class="wordmark" href="/" aria-label={`${studio.name}, početna`}>{studio.name}</a>
    <nav class="links" aria-label="Glavna navigacija">
      {nav.map((item) => <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>)}
    </nav>
    <div class="actions">
      <a class="ig" href={studio.instagram} target="_blank" rel="noopener">
        <Icon name="instagram" size={20} label="Instagram" />
      </a>
      <a class="zn-btn header-cta" href="/kontakt">Pošalji upit</a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobilni-meni" data-menu-toggle>
        <span class="open"><Icon name="menu" size={22} /></span>
        <span class="shut"><Icon name="close" size={22} /></span>
        <span class="visually-hidden">Meni</span>
      </button>
    </div>
  </div>
  <div class="drawer" id="mobilni-meni" hidden data-menu>
    <nav class="wrap" aria-label="Mobilna navigacija">
      {nav.map((item) => <a href={item.href}>{item.label}<Icon name="arrow-right" /></a>)}
      <a class="zn-btn zn-btn-block" href="/kontakt">Pošalji upit</a>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  if (header) {
    const onScroll = () => header.classList.toggle('scrolled', window.scrollY > 24);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
  if (toggle && menu && header) {
    const set = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      menu.hidden = !open;
      header.classList.toggle('menu-open', open);
    };
    toggle.addEventListener('click', () => set(toggle.getAttribute('aria-expanded') !== 'true'));
    menu.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) set(false); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') set(false); });
  }
</script>

<style>
  .site-header { position: sticky; top: 0; z-index: 50; background: var(--surface); border-bottom: 1px solid var(--line); transition: background-color 300ms ease, border-color 300ms ease; }
  .site-header.overlay { position: fixed; inset: 0 0 auto 0; background: transparent; border-bottom-color: transparent; }
  .site-header.overlay.scrolled, .site-header.overlay.menu-open { background: var(--surface); border-bottom-color: var(--line); }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: var(--space-24); height: 80px; }
  .wordmark { font: 700 18px/1 var(--font-sans); letter-spacing: 0.32em; text-transform: uppercase; text-decoration: none; color: var(--ink); padding-left: 0.32em; margin-left: -0.32em; }
  .links { display: flex; gap: var(--space-32); }
  .links a { font: 600 12px/16px var(--font-sans); letter-spacing: 0.16em; text-transform: uppercase; text-decoration: none; padding-block: var(--space-8); background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat; transition: background-size 400ms var(--ease-out); }
  .links a:hover, .links a[aria-current='page'] { background-size: 100% 1px; }
  .actions { display: flex; align-items: center; gap: var(--space-16); }
  .ig { display: inline-grid; place-items: center; width: 44px; height: 44px; color: var(--ink); }
  .ig:hover { color: var(--leaf); }
  .header-cta { height: 44px; }
  .menu-toggle { display: none; width: 44px; height: 44px; place-items: center; background: none; border: 0; color: var(--ink); cursor: pointer; }
  .menu-toggle .shut, .menu-toggle[aria-expanded='true'] .open { display: none; }
  .menu-toggle[aria-expanded='true'] .shut { display: block; }
  .drawer { border-top: 1px solid var(--line); background: var(--surface); }
  .drawer nav { display: grid; padding-block: var(--space-16) var(--space-32); }
  .drawer nav a:not(.zn-btn) { display: flex; justify-content: space-between; align-items: center; padding-block: var(--space-16); border-bottom: 1px solid var(--line); font: 600 20px/28px var(--font-sans); text-decoration: none; }
  .drawer .zn-btn { margin-top: var(--space-24); }
  @media (max-width: 1020px) {
    .links, .header-cta { display: none; }
    .menu-toggle { display: inline-grid; }
    .bar { height: 64px; }
  }
</style>
