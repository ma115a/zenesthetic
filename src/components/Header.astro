---
import Icon from './Icon.astro';
import { nav, studio } from '../data/site';

interface Props { overlay?: boolean }
const { overlay = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '');
const isCurrent = (href: string) => path === href || path.startsWith(href + '/');
---
<header class:list={['site-header', { overlay }]} data-header>
  <div class="bar wrap">
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobilni-meni" data-menu-toggle>
      <span class="open"><Icon name="menu" size={22} /></span>
      <span class="shut"><Icon name="close" size={22} /></span>
      <span class="visually-hidden">Meni</span>
    </button>
    <nav class="links links-start" aria-label="Glavna navigacija">
      {nav.slice(0, 3).map((item) => <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>)}
    </nav>
    <a class="wordmark" href="/" aria-label={`${studio.name} esthetic, početna`}><span class="logo" aria-hidden="true"></span></a>
    <div class="actions">
      <nav class="links" aria-label="Glavna navigacija, nastavak">
        {nav.slice(3).map((item) => <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>)}
      </nav>
      <a class="ig" href={studio.instagram} target="_blank" rel="noopener">
        <Icon name="instagram" size={20} label="Instagram" />
      </a>
      <a class="zn-btn header-cta" href="/kontakt">Pošalji upit</a>
    </div>
  </div>
  <div class="drawer" id="mobilni-meni" hidden data-menu>
    <nav class="wrap" aria-label="Mobilna navigacija">
      {nav.map((item) => <a href={item.href}>{item.label}<Icon name="arrow-right" /></a>)}
      <a class="zn-btn zn-btn-block" href="/kontakt">Pošalji upit</a>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  if (header) {
    const onScroll = () => header.classList.toggle('scrolled', window.scrollY > 24);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
  if (toggle && menu && header) {
    const set = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      menu.hidden = !open;
      header.classList.toggle('menu-open', open);
    };
    toggle.addEventListener('click', () => set(toggle.getAttribute('aria-expanded') !== 'true'));
    menu.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) set(false); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') set(false); });
  }
</script>

<style>
  .site-header { position: sticky; top: 0; z-index: 50; background: var(--surface); border-bottom: 1px solid var(--line); transition: background-color 300ms var(--ease-out), border-color 300ms var(--ease-out), color 300ms var(--ease-out); }
  .site-header.overlay { position: fixed; inset: 0 0 auto 0; background: transparent; border-bottom-color: transparent; }
  .site-header.overlay:not(.scrolled):not(.menu-open) { color: var(--on-ink); }
  .site-header.overlay:not(.scrolled):not(.menu-open) .wordmark,
  .site-header.overlay:not(.scrolled):not(.menu-open) .links a,
  .site-header.overlay:not(.scrolled):not(.menu-open) .ig,
  .site-header.overlay:not(.scrolled):not(.menu-open) .menu-toggle { color: var(--on-ink); }
  .site-header.overlay:not(.scrolled):not(.menu-open) .wordmark { color: var(--sage); }
  .site-header.overlay:not(.scrolled):not(.menu-open) .ig:hover { color: var(--sage); }
  .site-header.overlay:not(.scrolled):not(.menu-open) .header-cta { background: var(--sage); border-color: var(--sage); color: var(--ink); }
  .site-header.overlay:not(.scrolled):not(.menu-open) .header-cta:hover { background: var(--on-ink); border-color: var(--on-ink); color: var(--ink); }
  .site-header.overlay:not(.scrolled):not(.menu-open) a:focus-visible,
  .site-header.overlay:not(.scrolled):not(.menu-open) button:focus-visible { outline: 2px solid var(--sage); outline-offset: 2px; box-shadow: none; }
  .site-header.overlay.scrolled, .site-header.overlay.menu-open { background: var(--surface); border-bottom-color: var(--line); }
  /* Split bar: three links, the logo centred, two links + Instagram + upit. The bar keeps one height; only the logo scales on scroll. */
  .bar { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); align-items: center; gap: var(--space-32); height: var(--header-h); }
  .wordmark { display: inline-flex; color: var(--leaf); transition: color 300ms var(--ease-out); }
  .wordmark .logo { height: 76px; transform-origin: center; transition: transform 400ms var(--ease-out); }
  .site-header.scrolled .wordmark .logo { transform: scale(0.74); }
  .links { display: flex; gap: var(--space-32); }
  .links a { font: 600 12px/16px var(--font-sans); letter-spacing: 0.16em; text-transform: uppercase; text-decoration: none; white-space: nowrap; padding-block: var(--space-8); background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat; transition: background-size 400ms var(--ease-out); }
  .links a:hover, .links a[aria-current='page'] { background-size: 100% 1px; }
  .actions { display: flex; align-items: center; justify-content: flex-end; gap: var(--space-24); }
  .actions .links { margin-right: var(--space-8); }
  .ig { display: inline-grid; place-items: center; width: 44px; height: 44px; margin-inline: calc(-1 * var(--space-12)); color: var(--ink); }
  .ig:hover { color: var(--leaf); }
  .header-cta { height: 44px; }
  .menu-toggle { display: none; width: 44px; height: 44px; place-items: center; padding: 0; background: none; border: 0; color: var(--ink); cursor: pointer; }
  .menu-toggle .shut, .menu-toggle[aria-expanded='true'] .open { display: none; }
  .menu-toggle[aria-expanded='true'] .shut { display: block; }
  .drawer { border-top: 1px solid var(--line); background: var(--surface); }
  .drawer nav { display: grid; padding-block: var(--space-16) var(--space-32); }
  .drawer nav a:not(.zn-btn) { display: flex; justify-content: space-between; align-items: center; padding-block: var(--space-16); border-bottom: 1px solid var(--line); font: 600 20px/28px var(--font-sans); text-decoration: none; }
  .drawer .zn-btn { margin-top: var(--space-24); }
  @media (max-width: 1100px) {
    .links, .header-cta { display: none; }
    .bar { grid-template-columns: 44px 1fr 44px; gap: var(--space-16); }
    .menu-toggle { display: inline-grid; margin-left: calc(-1 * var(--space-12)); }
    .wordmark { justify-self: center; }
    .wordmark .logo { height: 50px; }
    .site-header.scrolled .wordmark .logo { transform: none; }
    .actions { gap: 0; }
    .ig { margin-inline: 0 calc(-1 * var(--space-12)); }
  }
  @media (prefers-reduced-motion: reduce) { .wordmark .logo { transition: none; } }
</style>
