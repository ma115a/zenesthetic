---
import { visitSteps } from '../data/site';
---
<ol class="steps">
  {visitSteps.map((s, i) => (
    <li data-reveal style={`--delay: ${i * 80}ms`}>
      <span class="num">{String(i + 1).padStart(2, '0')}</span>
      <h3>{s.title}</h3>
      <p>{s.text}</p>
    </li>
  ))}
</ol>

<style>
  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-24); }
  li { display: grid; gap: var(--space-12); align-content: start; padding-top: var(--space-24); border-top: 1px solid var(--ink); }
  .num { font: 400 italic 40px/1 var(--font-accent); color: var(--leaf); }
  h3 { font: 600 20px/28px var(--font-sans); }
  p { color: var(--ink-muted); font-size: 15px; line-height: 24px; }
  @media (max-width: 900px) { .steps { grid-template-columns: 1fr 1fr; gap: var(--space-32) var(--space-24); } }
  @media (max-width: 520px) { .steps { grid-template-columns: 1fr; } }
</style>
