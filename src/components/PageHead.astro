---
import { unsplash } from '../data/site';

interface Props { title: string; accent?: string; lead?: string; crumbs?: { label: string; href?: string }[]; photo?: string; photoAlt?: string }
const { title, accent, lead, crumbs = [], photo, photoAlt = '' } = Astro.props;
---
<section class:list={['page-head', { 'has-photo': photo }]}>
  <div class="wrap inner">
    <div class="copy">
      {crumbs.length > 0 && (
        <nav class="crumbs" aria-label="Putanja">
          <a href="/">Početna</a>
          {crumbs.map((c) => (<><span aria-hidden="true">/</span>{c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</>))}
        </nav>
      )}
      <h1 class="zn-heading zn-heading-display">{title}{accent && <> <em class="zn-accent">{accent}</em></>}</h1>
      {lead && <p class="lead">{lead}</p>}
      <slot />
    </div>
    {photo && (
      <div class="photo">
        <img src={unsplash(photo, 1000, 1250)} alt={photoAlt} fetchpriority="high" />
      </div>
    )}
  </div>
</section>

<style>
  .page-head { padding-block: var(--space-80) var(--space-80); border-bottom: 1px solid var(--line); }
  .inner { display: grid; gap: var(--space-48); }
  .has-photo .inner { grid-template-columns: 7fr 5fr; align-items: end; }
  .copy { display: grid; gap: var(--space-24); justify-items: start; align-content: end; }
  .zn-heading-display { font-size: clamp(40px, 5.2vw, 72px); line-height: 0.98; }
  .zn-heading-display .zn-accent { font-size: 1.14em; }
  .photo img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; }
  .has-photo { padding-bottom: 0; border-bottom: 0; }
  .has-photo .copy { padding-bottom: var(--space-80); }
  @media (max-width: 900px) {
    .page-head { padding-block: var(--space-48); }
    .has-photo .inner { grid-template-columns: 1fr; }
    .has-photo .copy { padding-bottom: 0; }
    .photo img { aspect-ratio: 4 / 3; }
  }
</style>
