---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import VisitSteps from '../../components/VisitSteps.astro';
import EnquiryBand from '../../components/EnquiryBand.astro';
import Icon from '../../components/Icon.astro';
import { treatmentList, areaLabel, faq, lorem, unsplash, type Treatment } from '../../data/site';

export function getStaticPaths() {
  return treatmentList.map((t) => ({ params: { slug: t.slug }, props: { t } }));
}
const { t } = Astro.props as { t: Treatment };
const related = treatmentList.filter((x) => x.area === t.area && x.slug !== t.slug).slice(0, 3);
const facts = [
  ['Trajanje', t.duration],
  ['Preporučeno', t.sessions],
  ['Razmak', t.interval],
  ['Uređaj', t.device],
];
---
<Base title={`${t.name} · Tretmani · Zen`} description={t.summary}>
  <PageHead
    title={t.name}
    lead={t.summary}
    crumbs={[{ label: 'Tretmani', href: '/tretmani' }, { label: areaLabel[t.area], href: `/tretmani#${t.area}` }, { label: t.name }]}
    photo={t.photo}
    photoAlt={`Tretman ${t.name} (privremena fotografija)`}
  >
    <dl class="facts">
      {facts.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
    </dl>
    <a class="zn-btn" href="#upit">Pošalji upit za ovaj tretman <Icon name="arrow-right" /></a>
  </PageHead>

  <section class="section">
    <div class="wrap about-grid">
      <h2 class="zn-heading zn-heading-h2">O <em class="zn-accent">tretmanu</em></h2>
      <div class="prose">
        <p class="lead">{lorem.intro}</p>
        <p>{lorem.body}</p>
        <h3>Za koga je</h3>
        <ul>
          <li>Lorem ipsum dolor sit amet, consectetur adipiscing elit.</li>
          <li>Sed do eiusmod tempor incididunt ut labore et dolore.</li>
          <li>Ut enim ad minim veniam, quis nostrud exercitation.</li>
        </ul>
        <h3>Kada ga ne preporučujem</h3>
        <p>{lorem.body}</p>
      </div>
    </div>
  </section>

  <section class="section mist" aria-labelledby="tok-naslov">
    <div class="wrap">
      <div class="section-head"><h2 id="tok-naslov" class="zn-heading zn-heading-h2">Tok <em class="zn-accent">tretmana</em></h2></div>
      <VisitSteps />
    </div>
  </section>

  <section class="section" aria-labelledby="pitanja-naslov">
    <div class="wrap about-grid">
      <h2 id="pitanja-naslov" class="zn-heading zn-heading-h2">Česta <em class="zn-accent">pitanja</em></h2>
      <div class="faq">
        {faq.map((f) => (
          <details>
            <summary><span>{f.q}</span><span class="plus" aria-hidden="true"></span></summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  {related.length > 0 && (
    <section class="section related" aria-labelledby="slicni-naslov">
      <div class="wrap">
        <div class="section-head">
          <h2 id="slicni-naslov" class="zn-heading zn-heading-h2">Slični <em class="zn-accent">tretmani</em></h2>
          <a class="text-link" href="/tretmani">Svi tretmani <Icon name="arrow-right" /></a>
        </div>
        <div class="related-grid">
          {related.map((r) => (
            <a class="zn-card" href={`/tretmani/${r.slug}`} data-reveal>
              <div class="zn-photo" style="aspect-ratio: 4 / 5"><img src={unsplash(r.photo, 700, 875)} alt="" loading="lazy" /></div>
              <div class="zn-card-body">
                <h3 class="zn-card-title"><span>{r.name}</span><Icon name="arrow-up-right" /></h3>
                <span class="zn-card-meta">{areaLabel[r.area]} · {r.duration} · {r.sessions}</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <EnquiryBand selected={t.slug} />
</Base>

<style>
  .facts { margin: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); width: 100%; max-width: 560px; border-top: 1px solid var(--ink); }
  .facts div { padding: var(--space-16) 0; border-bottom: 1px solid var(--line); display: grid; gap: 2px; }
  .facts div:nth-child(odd) { padding-right: var(--space-24); }
  .facts dt { font: 600 11px/16px var(--font-sans); letter-spacing: 0.18em; text-transform: uppercase; color: var(--leaf); }
  .facts dd { margin: 0; font: 600 18px/26px var(--font-sans); font-variant-numeric: tabular-nums; }
  .about-grid { display: grid; grid-template-columns: 5fr 7fr; gap: var(--space-80); align-items: start; }
  .prose { display: grid; gap: var(--space-16); max-width: var(--text-max); }
  .prose h3 { font: 600 20px/28px var(--font-sans); margin-top: var(--space-24); }
  .prose ul { margin: 0; padding-left: 1.1em; display: grid; gap: var(--space-8); }
  .prose li::marker { color: var(--leaf); }
  .mist { background: var(--surface-mist); }
  .faq { border-top: 1px solid var(--ink); }
  details { border-bottom: 1px solid var(--line); }
  summary { display: flex; justify-content: space-between; align-items: center; gap: var(--space-24); padding-block: var(--space-24); cursor: pointer; list-style: none; font: 600 18px/26px var(--font-sans); }
  summary::-webkit-details-marker { display: none; }
  .plus { position: relative; flex: none; width: 16px; height: 16px; }
  .plus::before, .plus::after { content: ''; position: absolute; left: 0; top: 7.25px; width: 16px; height: 1.5px; background: var(--ink); transition: transform 300ms var(--ease-out); }
  .plus::after { transform: rotate(90deg); }
  details[open] .plus::after { transform: rotate(0deg); }
  details p { padding-bottom: var(--space-24); color: var(--ink-muted); max-width: var(--text-max); }
  .related-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-24); }
  .zn-photo img { aspect-ratio: 4 / 5; }
  @media (max-width: 900px) { .about-grid { grid-template-columns: 1fr; gap: var(--space-32); } .related-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .related-grid { grid-template-columns: 1fr; } }
</style>
