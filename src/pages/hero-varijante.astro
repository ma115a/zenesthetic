---
// Temporary comparison page for choosing the hero. Delete after the choice.
import '../styles/global.css';
import Hero from '../components/Hero.astro';
const variants = [
  ['sage-wash', 'A · Kadulja preko fotografije'],
  ['sage-panel', 'B · Blok kadulje na fotografiji'],
  ['warm-dark', 'C · Toplo i tamno'],
] as const;
---
<html lang="sr-Latn">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="robots" content="noindex" /><title>Hero varijante · Zen</title></head>
  <body>
    {variants.map(([v, label]) => (
      <div class="variant" id={v}>
        <p class="label">{label}</p>
        <Hero variant={v} id={`h-${v}`} />
      </div>
    ))}
    <style>
      .variant { border-bottom: 8px solid var(--ink); }
      .label { position: sticky; top: 0; z-index: 5; margin: 0; padding: 12px 16px; background: var(--ink); color: var(--on-ink); font: 600 12px/16px var(--font-sans); letter-spacing: .16em; text-transform: uppercase; }
    </style>
  </body>
</html>
