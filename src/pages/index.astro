---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import TreatmentMenu from '../components/TreatmentMenu.astro';
import ProductCard from '../components/ProductCard.astro';
import EnquiryBand from '../components/EnquiryBand.astro';
import Testimonials from '../components/Testimonials.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import { unsplash, devices, galleryItems, products, photos, studio, beforeAfter } from '../data/site';
const tiles = galleryItems.filter((g) => !beforeAfter.some((b) => b.after === g.photo || b.before === g.photo)).slice(0, 3);
---
<Base
  title="Zen · Tretmani lica i tijela"
  description="Tretmani lica i tijela naprednim uređajima, uz više od 10 godina iskustva. Pošaljite upit putem forme ili Instagrama."
  overlayHeader
>
  <!-- Hero: one full-bleed picture carries the heading -->
  <section class="hero" aria-labelledby="hero-naslov">
    <img
      class="hero-img"
      src={unsplash(photos.hero, 1920)}
      srcset={`${unsplash(photos.hero, 900)} 900w, ${unsplash(photos.hero, 1400)} 1400w, ${unsplash(photos.hero, 2200)} 2200w`}
      sizes="100vw"
      alt="Tretman lica uređajem u rukama specijalistkinje"
      fetchpriority="high"
    />
    <div class="hero-copy wrap">
      <h1 id="hero-naslov" class="zn-heading zn-heading-display">Rezultati koje <em class="zn-accent">vidite</em></h1>
      <p class="hero-line">Tretmani lica i tijela naprednim uređajima, uz više od 10 godina iskustva.</p>
      <div class="hero-actions">
        <a class="zn-btn" href="#upit">Pošalji upit <Icon name="arrow-right" /></a>
        <a class="zn-btn zn-btn-outline on-photo" href="#tretmani">Pogledaj tretmane</a>
      </div>
    </div>
  </section>

  <!-- Treatment menu: the signature section -->
  <section id="tretmani" class="menu section" aria-labelledby="meni-naslov">
    <div class="wrap">
      <div class="section-head">
        <h2 id="meni-naslov" class="zn-heading zn-heading-h2">Ponuda <em class="zn-accent">tretmana</em></h2>
        <a class="text-link" href="/tretmani">Svi tretmani <Icon name="arrow-right" /></a>
      </div>

      <TreatmentMenu />
    </div>
  </section>

  <!-- The specialist -->
  <section class="about section" aria-labelledby="o-meni-naslov">
    <div class="wrap about-grid">
      <div class="about-photo" data-reveal>
        <img src={unsplash(photos.portrait, 900, 1125)} alt="Specijalistkinja u studiju (privremena fotografija)" loading="lazy" />
      </div>
      <div class="about-copy" data-reveal style="--delay: 120ms">
        <h2 id="o-meni-naslov" class="zn-heading zn-heading-h2">Više od 10 godina <em class="zn-accent">iskustva</em></h2>
        <p class="lead">Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua, ut enim ad minim veniam.</p>
        <p class="muted">Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident.</p>
        <p class="signature"><span class="sig-name">Ime Prezime</span><span class="muted">osnivačica studija {studio.name}</span></p>
        <a class="zn-btn zn-btn-outline" href="/o-meni">Više o meni</a>
      </div>
    </div>
  </section>

  <!-- Technology -->
  <section class="tech section" aria-labelledby="tehnologija-naslov">
    <div class="wrap tech-grid">
      <div class="tech-copy">
        <h2 id="tehnologija-naslov" class="zn-heading zn-heading-h2">Napredna <em class="zn-accent">tehnologija</em></h2>
        <p class="lead">Lorem ipsum dolor sit amet, consectetur adipiscing elit. Svaki uređaj biramo prema vrsti kože i cilju tretmana.</p>
        <dl class="devices">
          {devices.map((d, i) => (
            <div class="device" data-reveal style={`--delay: ${i * 80}ms`}>
              <dt><span class="device-name">{d.name}</span><span class="device-area">{d.area}</span></dt>
              <dd>{d.text}</dd>
            </div>
          ))}
        </dl>
      </div>
      <div class="tech-photo" data-reveal>
        <img src={unsplash(photos.device, 900, 1125)} alt="Tretman tijela uređajem" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- Gallery preview -->
  <section class="gallery section" aria-labelledby="galerija-naslov">
    <div class="wrap">
      <div class="section-head">
        <h2 id="galerija-naslov" class="zn-heading zn-heading-h2">Prije i <em class="zn-accent">poslije</em></h2>
        <a class="text-link" href="/galerija">Pogledaj galeriju <Icon name="arrow-right" /></a>
      </div>
      <div class="gallery-grid">
        <div class="g g1" data-reveal><BeforeAfter pair={beforeAfter[0]} ratio="4 / 5" width={1000} id="ba-home" /></div>
        {tiles.map((g, i) => (
          <a class={`g g${i + 2}`} href="/galerija" data-reveal style={`--delay: ${(i + 1) * 80}ms`}>
            <img src={unsplash(g.photo, 700, 700)} alt={g.alt} loading="lazy" />
          </a>
        ))}
      </div>
    </div>
  </section>

  <Testimonials />

  <!-- Products -->
  <section class="products section" aria-labelledby="proizvodi-naslov">
    <div class="wrap">
      <div class="section-head">
        <div class="head-stack">
          <h2 id="proizvodi-naslov" class="zn-heading zn-heading-h2">Njega i <em class="zn-accent">kod kuće</em></h2>
          <p class="muted">Proizvodi koje preporučujem nakon tretmana. Naručite putem forme, a ja vam javljam dostupnost.</p>
        </div>
        <a class="text-link" href="/proizvodi">Svi proizvodi <Icon name="arrow-right" /></a>
      </div>
      <div class="product-grid">
        {products.slice(0, 4).map((p, i) => <ProductCard product={p} delay={i * 80} />)}
      </div>
    </div>
  </section>

  <EnquiryBand />
</Base>


<style>
  /* Hero */
  .hero { position: relative; display: flex; align-items: flex-end; min-height: max(560px, calc(100svh - 168px)); overflow: hidden; isolation: isolate; background: var(--surface-mist); }
  .hero-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 62% 40%; z-index: -2; animation: hero-drift 14s var(--ease-out) both; }
  .hero::after { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, #ffffffcc 0%, #ffffff00 18%), linear-gradient(90deg, #ffffffeb 0%, #ffffffc7 30%, #ffffff00 62%), linear-gradient(0deg, #ffffffb3 0%, #ffffff00 40%); }
  @keyframes hero-drift { from { transform: scale(1.06); } to { transform: scale(1); } }
  .hero-copy { padding-block: var(--space-120) var(--space-80); display: grid; gap: var(--space-24); justify-items: start; }
  .hero .zn-heading-display { font-size: clamp(44px, 6.4vw, 88px); line-height: 0.95; max-width: 9.5em; }
  .hero .zn-heading-display .zn-accent { font-size: 1.14em; }
  .hero-line { font-size: 18px; line-height: 30px; max-width: 34ch; color: var(--ink); }
  .hero-actions { display: flex; flex-wrap: wrap; gap: var(--space-8); }
  .zn-btn-outline.on-photo { background: #ffffffb3; }
  .zn-btn-outline.on-photo:hover { background: var(--ink); }
  @media (prefers-reduced-motion: reduce) { .hero-img { animation: none; } }
  @media (max-width: 760px) {
    .hero { min-height: 640px; }
    .hero-img { object-position: 70% 30%; }
    .hero::after { background: linear-gradient(0deg, #ffffff 0%, #fffffff0 38%, #ffffff00 70%); }
    .hero-copy { padding-block: var(--space-80) var(--space-48); }
  }

  .menu { padding-top: var(--space-80); }

  /* About */
  .about { background: var(--surface-mist); }
  .about-grid { display: grid; grid-template-columns: 5fr 6fr; gap: var(--space-80); align-items: center; }
  .about-photo { position: relative; }
  .about-photo img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; }
  .about-copy { display: grid; gap: var(--space-24); justify-items: start; }
  .signature { display: grid; gap: var(--space-4); padding-top: var(--space-8); }
  .sig-name { font: 400 italic 28px/1.1 var(--font-accent); color: var(--leaf); }
  @media (max-width: 900px) { .about-grid { grid-template-columns: 1fr; gap: var(--space-48); } }

  /* Technology */
  .tech-grid { display: grid; grid-template-columns: 6fr 5fr; gap: var(--space-80); align-items: center; }
  .tech-copy { display: grid; gap: var(--space-24); }
  .devices { margin: var(--space-16) 0 0; border-top: 1px solid var(--ink); }
  .device { display: grid; grid-template-columns: 1fr 1.4fr; gap: var(--space-24); padding-block: var(--space-24); border-bottom: 1px solid var(--line); }
  .device dt { display: grid; gap: var(--space-4); }
  .device-name { font: 600 20px/28px var(--font-sans); }
  .device-area { font: 600 11px/16px var(--font-sans); letter-spacing: 0.18em; text-transform: uppercase; color: var(--leaf); }
  .device dd { margin: 0; color: var(--ink-muted); font-size: 15px; line-height: 24px; }
  .tech-photo img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; }
  @media (max-width: 900px) { .tech-grid { grid-template-columns: 1fr; gap: var(--space-48); } .tech-photo { order: -1; } .tech-photo img { aspect-ratio: 4 / 3; } }
  @media (max-width: 520px) { .device { grid-template-columns: 1fr; gap: var(--space-8); } }

  /* Gallery */
  .gallery { padding-top: 0; }
  .gallery-grid { display: grid; grid-template-columns: 1.3fr 1fr 1fr; grid-template-rows: auto auto; gap: var(--space-16); }
  .g { display: block; overflow: hidden; background: var(--surface-mist); }
  .g img { width: 100%; height: 100%; object-fit: cover; transition: transform 900ms var(--ease-out); }
  .g:hover img { transform: scale(1.04); }
  .g1 { grid-row: span 2; }
  .g1 :global(.ba) { aspect-ratio: auto !important; height: 100%; min-height: 480px; }
  .g2, .g3 { aspect-ratio: 1; }
  .g4 { grid-column: span 2; aspect-ratio: 2 / 1; }
  @media (max-width: 680px) { .gallery-grid { grid-template-columns: 1fr 1fr; } .g1 { grid-column: span 2; grid-row: auto; } .g1 :global(.ba) { aspect-ratio: 4 / 5 !important; height: auto; min-height: 0; } }

  .head-stack { display: grid; gap: var(--space-12); max-width: 52ch; }
</style>
