---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { nav } from '../data/site';
---
<Base title="Stranica nije pronađena · Zen" description="Ova stranica ne postoji.">
  <section class="section nf">
    <div class="wrap grid">
      <p class="code" aria-hidden="true">404</p>
      <div class="copy">
        <h1 class="zn-heading zn-heading-h2">Stranica nije <em class="zn-accent">pronađena</em></h1>
        <p class="lead">Adresa je možda promijenjena ili sadrži grešku. Evo gdje možete nastaviti:</p>
        <ul>
          <li><a href="/">Početna <Icon name="arrow-right" /></a></li>
          {nav.map((n) => <li><a href={n.href}>{n.label} <Icon name="arrow-right" /></a></li>)}
        </ul>
      </div>
    </div>
  </section>
</Base>

<style>
  .grid { display: grid; grid-template-columns: 5fr 7fr; gap: var(--space-80); align-items: center; }
  .code { font: 400 italic clamp(120px, 18vw, 240px)/0.85 var(--font-accent); color: var(--sage); }
  .copy { display: grid; gap: var(--space-24); }
  ul { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--ink); max-width: 420px; }
  li a { display: flex; justify-content: space-between; align-items: center; padding-block: var(--space-16); border-bottom: 1px solid var(--line); font: 600 18px/26px var(--font-sans); text-decoration: none; }
  li a:hover { color: var(--leaf); }
  @media (max-width: 760px) { .grid { grid-template-columns: 1fr; gap: var(--space-24); } }
</style>
